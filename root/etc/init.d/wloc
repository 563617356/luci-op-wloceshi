#!/bin/sh /etc/rc.common
# procd 服务脚本：管理 mitmproxy + wloc addon

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/mitmdump
ADDON=/usr/libexec/wloc/wloc_addon.py
CONFIG=/etc/config/wloc
STATE_DIR=/var/run/wloc

# 只对 Apple 定位域名做 MITM，其余流量走裸隧道不解密。
# 负向先行断言确保不会误解密其它站点。
IGNORE_HOSTS='^(?!(gs-loc\.apple\.com|gs-loc-cn\.apple\.com)$)'

uci_get() {
	uci -q get "wloc.main.$1" 2>/dev/null
}

start_instance() {
	local port addr level

	port="$(uci_get listen_port)"
	[ -n "$port" ] || port=8080

	addr="$(uci_get listen_addr)"
	[ -n "$addr" ] || addr=0.0.0.0

	level="$(uci_get log_level)"
	[ -n "$level" ] || level=info

	mkdir -p "$STATE_DIR" /var/log

	# shellcheck disable=SC2086
	procd_open_instance wloc
	procd_set_param command "$PROG" \
		--mode regular \
		--listen-host "$addr" \
		--listen-port "$port" \
		--set connection_strategy=lazy \
		--set keep_host_header \
		--set term_size_ansi=64 \
		--set flow_detail=0 \
		--ignore-hosts "$IGNORE_HOSTS" \
		--scripts "$ADDON"

	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONFIG"
	procd_close_instance
}

start() {
	[ -x "$PROG" ] || {
		echo "wloc: $PROG 未安装，请先运行 wloc-ctl setup" >&2
		return 1
	}
	[ -f "$ADDON" ] || {
		echo "wloc: addon 缺失 $ADDON" >&2
		return 1
	}
	start_instance
}

service_triggers() {
	procd_add_reload_trigger "wloc"
}

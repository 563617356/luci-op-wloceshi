#!/bin/sh
# wloc-ctl —— luci-app-wloc 辅助命令
#
#   setup     安装 mitmproxy（耗时较久，会占用较多闪存）
#   status    查看运行状态与统计
#   ca        输出 CA 证书文件路径
#   ca-export 输出 CA 证书内容（.cer），用于安装到 iPhone
#   test      用合成回包自检改包逻辑
#   start|stop|restart|enable|disable  透传 init 脚本

set -e

ADDON_DIR=/usr/libexec/wloc
STATE_FILE=/var/run/wloc/stats.json
CERT_DIR=/etc/wloc
CERT_BUNDLE="$CERT_DIR/mitmproxy-ca-cert.cer"

die() {
	echo "wloc-ctl: $*" >&2
	exit 1
}

need_root() {
	[ "$(id -u)" = "0" ] || die "需要 root 权限"
}

cmd_setup() {
	need_root

	if command -v mitmdump >/dev/null 2>&1; then
		echo "mitmproxy 已安装: $(mitmdump --version 2>/dev/null | head -n1)"
		return 0
	fi

	echo "==> 安装依赖（python3 / openssl / libffi）"
	install_deps || die "依赖安装失败，请手动安装 python3 与 pip"

	echo "==> 安装 mitmproxy（可能需要 5-10 分钟）"
	install_mitmproxy || die \
		"mitmproxy 安装失败。OpenWrt 为 musl 环境，可先装编译依赖后重试：
	apk add build-base python3-dev
	opkg install build-base python3-dev"

	mkdir -p "$CERT_DIR"

	command -v mitmdump >/dev/null 2>&1 ||
		die "安装后仍找不到 mitmdump"

	echo "==> 导出 CA 证书"
	mitmdump --set confdir="$CERT_DIR" --version >/dev/null 2>&1 || true
	generate_cert

	echo "完成。执行 wloc-ctl ca-export 查看证书。"
}

install_deps() {
	# 兼容 apk(OpenWrt 23.05+/快照) 与 opkg(旧版) 两套包管理器
	if command -v apk >/dev/null 2>&1; then
		apk add --no-cache python3 py3-pip openssl libffi && return 0
		return 1
	fi
	if command -v opkg >/dev/null 2>&1; then
		opkg update >/dev/null 2>&1
		opkg install python3 python3-pip openssl libffi && return 0
		return 1
	fi
	return 1
}

install_mitmproxy() {
	# apk 的 pip 需 --break-system-packages；旧版 pip 无此参数会直接报错，
	# 所以按顺序尝试，用 || 串联而不是 A && B || C（优先级会出错）。
	pip3 install --break-system-packages --no-cache-dir mitmproxy && return 0
	pip3 install --no-cache-dir mitmproxy && return 0
	return 1
}

generate_cert() {
	local src
	for src in \
		"$CERT_DIR/mitmproxy-ca-cert.cer" \
		"$CERT_DIR/mitmproxy-ca-cert.pem" \
		"$HOME/.mitmproxy/mitmproxy-ca-cert.cer"
	do
		[ -f "$src" ] && { echo "证书: $src"; return 0; }
	done
	echo "尚未生成证书，启动一次服务后会自动创建。" >&2
	return 1
}

cmd_status() {
	echo "=== 服务状态 ==="
	if pgrep -f mitmdump >/dev/null 2>&1; then
		echo "mitmdump: 运行中 (pid $(pgrep -f mitmdump | tr '\n' ' '))"
	else
		echo "mitmdump: 未运行"
	fi

	echo
	echo "=== UCI 配置 ==="
	uci show wloc 2>/dev/null || echo "(无配置)"

	echo
	echo "=== 统计 ==="
	if [ -f "$STATE_FILE" ]; then
		cat "$STATE_FILE"
		echo
	else
		echo "暂无统计（服务启动并处理过请求后生成）"
	fi

	echo
	echo "=== 资源占用 ==="
	if command -v free >/dev/null 2>&1; then
		free -m 2>/dev/null | head -n2
	fi
}

cmd_ca() {
	[ -f "$CERT_BUNDLE" ] && echo "$CERT_BUNDLE" || generate_cert
}

cmd_ca_export() {
	local cert
	cert="$(cmd_ca 2>/dev/null)" || die "CA 证书尚未生成"
	[ -f "$cert" ] || die "CA 证书不存在: $cert"
	echo "# 将以下内容保存为 wloc-ca.cer，通过隔空投送/邮件发到 iPhone"
	echo "# iPhone 侧：设置 > 通用 > VPN与设备管理 安装描述文件"
	echo "#          设置 > 通用 > 关于本机 > 证书信任设置 开启完全信任"
	echo "#"
	cat "$cert"
}

cmd_test() {
	[ -f "$ADDON_DIR/wloc_proto.py" ] || die "addon 文件缺失"
	python3 -c "
import sys
sys.path.insert(0, '$ADDON_DIR')
from wloc_proto import encode_field, patch_wloc_body
import struct

def pos(lat, lon, acc=25):
    return (encode_field(1,0,round(1e8*lat)) + encode_field(2,0,round(1e8*lon))
            + encode_field(3,0,acc))

mac = b'aa:bb:cc:dd:ee:ff'
wifi = encode_field(1,2,mac) + encode_field(2,2,pos(22.5,113.9))
cell = encode_field(5,2,pos(22.5,113.9))
payload = encode_field(2,2,wifi) + encode_field(22,2,cell)
body = b'\xff'*16 + struct.pack('>H', len(payload)) + payload + encode_field(11,0,3)

out, st = patch_wloc_body(body, 39.9042, 116.4074, 30)
print('patched bytes:', len(out))
print('stats:', st.as_dict())
assert st.locations == 2, 'expected 2 positions'
print('OK: 改包逻辑自检通过')
"
}

case "$1" in
	setup)      cmd_setup ;;
	status)     cmd_status ;;
	ca)         cmd_ca ;;
	ca-export)  cmd_ca_export ;;
	test)       cmd_test ;;
	start)      /etc/init.d/wloc start ;;
	stop)       /etc/init.d/wloc stop ;;
	restart)    /etc/init.d/wloc restart ;;
	reload)     /etc/init.d/wloc reload ;;
	enable)     /etc/init.d/wloc enable ;;
	disable)    /etc/init.d/wloc disable ;;
	*)
		cat <<'EOF'
用法: wloc-ctl <命令>

  setup       安装 mitmproxy 并生成 CA 证书
  status      查看服务状态、UCI 配置与统计
  ca          输出 CA 证书路径
  ca-export   输出 CA 证书内容（用于安装到 iPhone）
  test        用合成回包自检改包逻辑
  start       启动服务
  stop        停止服务
  restart     重启服务
  reload      重新加载配置
  enable      开机自启
  disable     取消开机自启
EOF
		exit 1
		;;
esac
